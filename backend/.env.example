# Leave LLM_API_KEY empty (or MOCK_LLM=true) to run fully offline with the rule-based fallback.
MOCK_LLM=true
LLM_PROVIDER=gemini            # gemini | anthropic | openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini-flash-lite-latest   # used on overload or quota errors
# Optional backup provider with its own key, tried after Gemini fails (groq | anthropic | openai | xai | gemini)
LLM_BACKUP_PROVIDER=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=              # defaults: groq openai/gpt-oss-120b, anthropic claude-haiku-5-5; required for openai and xai
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768                  # must match vector(768) in the migrations
# Leave the three Supabase values empty to run in offline demo mode (in-memory seeded data).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# One-click demo accounts: the server signs demo users in, so this password never reaches the browser.
# Use a long random value (e.g. `openssl rand -base64 24`), then run: python seed/rotate_demo_passwords.py
DEMO_USER_PASSWORD=
DEMO_MODE=true                 # false = real accounts only; hides the demo buttons
# Roles people may pick when creating their own account (admin left out on purpose)
SIGNUP_ALLOWED_ROLES=creator,manager,reviewer
TESSERACT_CMD=
